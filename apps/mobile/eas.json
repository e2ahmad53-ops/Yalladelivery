      "android": {
        "buildType": "apk"
      }
    },
    "store-production": {
      "env": {
        "EXPO_PUBLIC_APP_ROLE": "store"
      }
    },
    "captain-production": {
      "env": {
        "EXPO_PUBLIC_APP_ROLE": "captain"
      }
    }
  }
